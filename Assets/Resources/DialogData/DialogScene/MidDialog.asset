MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daf74795959cd744bb4ffca5e9aa3186, type: 3}
  m_Name: MidDialog
  m_EditorClassIdentifier: Assembly-CSharp::DialogData
  NextScene: BossGameplay
  PlayOncePerSession: 1
  Lines:
  - Speaker: Mariyati
    portrait: {fileID: 629400567948610330, guid: 7a46ddee279c0184094059a4d23d3e00, type: 3}
    Text: "\u201CPhew, that worked!\u201D"
  - Speaker: Naja
    portrait: {fileID: -2753138198643579184, guid: d72b351b7450cb541be22e06a633c467, type: 3}
    Text: "\u201CThere\u2019s more of them!\u201D"
  - Speaker: Mariyati
    portrait: {fileID: 629400567948610330, guid: 7a46ddee279c0184094059a4d23d3e00, type: 3}
    Text: "\u201CThis won\u2019t be easy.\u201D"
  - Speaker: Mariyati
    portrait: {fileID: 629400567948610330, guid: 7a46ddee279c0184094059a4d23d3e00, type: 3}
    Text: "\u201CI know this is a big favor to ask.\u201D"
  - Speaker: Mariyati
    portrait: {fileID: 629400567948610330, guid: 7a46ddee279c0184094059a4d23d3e00, type: 3}
    Text: "\u201CBut I need you to hold them up to the best of your abilities.\u201D"
  - Speaker: Eri
    portrait: {fileID: 4038183454373002819, guid: f9ed787c89d873a4892493c5190bd99e, type: 3}
    Text: "\u201CWe\u2019ll do it. Anything for our chief.\u201D"
  - Speaker: Mariyati
    portrait: {fileID: 629400567948610330, guid: 7a46ddee279c0184094059a4d23d3e00, type: 3}
    Text: "\u201CThank you.\u201D"
  - Speaker: Mariyati
    portrait: {fileID: 629400567948610330, guid: 7a46ddee279c0184094059a4d23d3e00, type: 3}
    Text: "\u201CI owe the village an explanation.\u201D"
  - Speaker: Mariyati
    portrait: {fileID: 629400567948610330, guid: 7a46ddee279c0184094059a4d23d3e00, type: 3}
    Text: "\u201CI wish you luck.\u201D"
  - Speaker: 
    portrait: {fileID: 0}
    Text: Mariyati leave the scene
  - Speaker: Wiguna
    portrait: {fileID: -8828040028221845382, guid: ab15dc8f60d02ef43808e0f7b1421fba, type: 3}
    Text: "\u201COkay, we just need to keep doing what the chief told us!\u201D"
  - Speaker: ???
    portrait: {fileID: 0}
    Text: "\u201CWhat are you all doing?\u201D"
  - Speaker: Wiguna
    portrait: {fileID: -8828040028221845382, guid: ab15dc8f60d02ef43808e0f7b1421fba, type: 3}
    Text: "\u201CHuh?\u201D"
  - Speaker: 
    portrait: {fileID: 0}
    Text: Junandar enter the scene
  - Speaker: Naja
    portrait: {fileID: -2753138198643579184, guid: d72b351b7450cb541be22e06a633c467, type: 3}
    Text: "\u201CYou\u2019re\u2026 the cook.\u201D"
  - Speaker: Naja
    portrait: {fileID: -2753138198643579184, guid: d72b351b7450cb541be22e06a633c467, type: 3}
    Text: "\u201CYou made these creatures!\u201D"
  - Speaker: Junandar
    portrait: {fileID: -4330617105125101780, guid: a755e02a59c4f4a4e9262d8ff79cabb4, type: 3}
    Text: "\u201CHow bold of you. But true.\u201D"
  - Speaker: Naja
    portrait: {fileID: -2753138198643579184, guid: d72b351b7450cb541be22e06a633c467, type: 3}
    Text: "\u201CWhat exactly are you plotting?\u201D"
  - Speaker: Junandar
    portrait: {fileID: 4684634255308240008, guid: 79daac20612f4d846836176318ef6f1a, type: 3}
    Text: "\u201CI could ask the same to you.\u201D"
  - Speaker: Junandar
    portrait: {fileID: 4684634255308240008, guid: 79daac20612f4d846836176318ef6f1a, type: 3}
    Text: "\u201CThis village will be mine.\u201D"
  - Speaker: Junandar
    portrait: {fileID: 4684634255308240008, guid: 79daac20612f4d846836176318ef6f1a, type: 3}
    Text: "\u201CAnd no one will void my plan.\u201D"
